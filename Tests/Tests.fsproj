<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>    <!-- Exe = console app -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <IsTestProject>true</IsTestProject> <!-- to exclude from fsdocs -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference> <!-- so that dependabot can check it https://github.com/dependabot/dependabot-core/issues/10883 -->

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Scriptorium.Quill" Version="0.7.1" /> <!-- test DSL and runner, for .NET and Fable JS/TS -->
    <PackageReference Include="Scriptorium.Nib" Version="0.4.1" />   <!-- assertions -->
    <PackageReference Include="FSharp.Core" Version="10.0.101" /><!-- `Include` syntax for dependabot. Scriptorium needs at least 10.0.101 -->

    <ProjectReference Include="../Src/ArrayT.fsproj" />
    <Compile Include="Module.fs" />
    <Compile Include="Module2.fs" />
    <Compile Include="Extensions.fs" />
    <Compile Include="FableParity.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
</Project>